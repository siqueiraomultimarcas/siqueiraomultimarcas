# Banco PostgreSQL (Neon)
# Obtenha em: https://neon.tech → New Project → Connection String
DATABASE_URL=postgresql://usuario:senha@ep-xxxx.us-east-2.aws.neon.tech/locadora?sslmode=require

# Chave secreta Flask (gere com: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=troque-por-uma-chave-secreta-forte

# Cloudinary — https://cloudinary.com → Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=seu_cloud_name
CLOUDINARY_API_KEY=sua_api_key
CLOUDINARY_API_SECRET=sua_api_secret

# SERPRO eFrotas / SNE — consulta de multas por placa
# Credenciais fornecidas pelo SERPRO na contratacao
EFROTAS_BASE_URL=https://hom-efrotas.np.estaleiro.serpro.gov.br
EFROTAS_TOKEN=
EFROTAS_TOKEN_CLIENT=
# Certificado de Maquina e-CNPJ A1 (ICP-Brasil) — a autenticacao real do eFrotas.
# Opcao 1 (nuvem): o .pfx/.p12 convertido para base64
EFROTAS_PFX_BASE64=
EFROTAS_PFX_SENHA=
# Opcao 2 (local): dois arquivos PEM ja no disco
EFROTAS_CERT_PATH=
EFROTAS_KEY_PATH=
# Token para o agendador chamar a sincronizacao de multas (header X-Cron-Token)
CRON_TOKEN=
